# Copy this file to .env and fill in your keys.
# Get a free Odds API key at https://the-odds-api.com

ODDS_API_KEY=your_key_here
ODDS_API_REGIONS=us
ODDS_API_FORMAT=american

# Optional: for AI-written card summaries
# OPENAI_API_KEY=your_openai_key_here

# Public prediction-market feeds (read-only prices; no trading / order execution)
# Disabled by default so offline/local runs do not call public feeds.
ENABLE_PREDICTION_MARKETS=false
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Database (SQLite by default)
HEADCRACK_DATABASE_URL=sqlite:///headcrack_ai.sqlite3
HEADCRACK_WAREHOUSE_URL=sqlite:///headcrack_warehouse.sqlite3
MODEL_REGISTRY_PATH=models/registry
LOG_LEVEL=INFO
